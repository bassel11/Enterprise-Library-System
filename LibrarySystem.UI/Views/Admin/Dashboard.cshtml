@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-dark text-white overflow-hidden position-relative">
                <div class="card-body p-4 p-md-5">
                    <div class="position-relative z-1">
                        <h2 class="fw-bold mb-2">Welcome Back, Administrator!</h2>
                        <p class="text-light opacity-75 mb-0">Here is the real-time overview of your enterprise library system.</p>
                    </div>
               </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">

        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white border-0 shadow-sm h-100 rounded-4 hover-lift transition-all">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75 fw-semibold">Total Books</h6>
                            <h2 class="fw-bold mb-0 display-6">@ViewBag.TotalBooks</h2>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-circle p-3">
                            <i class="bi bi-book fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white border-0 shadow-sm h-100 rounded-4 hover-lift transition-all">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75 fw-semibold">Available Now</h6>
                            <h2 class="fw-bold mb-0 display-6">@ViewBag.AvailableBooks</h2>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-circle p-3">
                            <i class="bi bi-check2-circle fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark border-0 shadow-sm h-100 rounded-4 hover-lift transition-all">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75 fw-semibold">Checked Out</h6>
                            <h2 class="fw-bold mb-0 display-6">@ViewBag.BorrowedBooks</h2>
                        </div>
                        <div class="bg-dark bg-opacity-10 rounded-circle p-3">
                            <i class="bi bi-journal-arrow-up fs-2 text-dark"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white border-0 shadow-sm h-100 rounded-4 hover-lift transition-all">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75 fw-semibold">Total Users</h6>
                            <h2 class="fw-bold mb-0 display-6">@ViewBag.TotalUsers</h2>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-circle p-3">
                            <i class="bi bi-people fs-2"></i>
                        </div>
                    </div>
                    <div class="mt-3 pt-3 border-top border-light border-opacity-25 small">
                        <i class="bi bi-person-check me-1"></i> <strong>@ViewBag.ActiveUsers</strong> Active Accounts
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .hover-lift:hover {
        transform: translateY(-7px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.15) !important;
    }

    .transition-all {
        transition: all 0.3s ease-in-out;
    }
</style>