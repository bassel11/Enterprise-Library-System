<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise Library</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #212529;
            color: white;
            box-shadow: 2px 0 5px rgba(0,0,0,0.1);
        }

            .sidebar .nav-link {
                color: #adb5bd;
                font-weight: 500;
                padding: 12px 20px;
                margin: 4px 10px;
                border-radius: 8px;
                transition: all 0.3s ease;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    color: #fff;
                    background-color: #0d6efd;
                }

        .main-content {
            padding: 30px;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <div class="sidebar d-flex flex-column" style="width: 280px;">
                <div class="p-4 d-flex align-items-center">
                    <i class="bi bi-book-half fs-3 text-primary me-2"></i>
                    <span class="fs-4 fw-bold">Library Pro</span>
                </div>
                <hr class="text-secondary m-0">

                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                }

                <ul class="nav nav-pills flex-column mt-3 mb-auto">

                    @* روابط الإدارة (Admin) *@
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a href="/Admin/Dashboard" class="nav-link @(currentController == "Admin" && currentAction == "Dashboard" ? "active" : "")">
                                <i class="bi bi-speedometer2 me-2"></i> Admin Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/ManageUsers" class="nav-link @(currentController == "Admin" && currentAction == "ManageUsers" ? "active" : "")">
                                <i class="bi bi-people me-2"></i> Manage Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/ManageBooks" class="nav-link @(currentController == "Admin" && currentAction == "ManageBooks" ? "active" : "")">
                                <i class="bi bi-journal-plus me-2"></i> Manage Books
                            </a>
                        </li>
                    }

                    @* روابط المستخدم العادي (User) *@
                    @if (User.IsInRole("User"))
                    {
                        <li class="nav-item">
                            <a href="/User/Dashboard" class="nav-link @(currentController == "User" && currentAction == "Dashboard" ? "active" : "")">
                                <i class="bi bi-house-door me-2"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/User/Search" class="nav-link @(currentController == "User" && currentAction == "Search" ? "active" : "")">
                                <i class="bi bi-search me-2"></i> Advanced Search
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/User/MyBorrowings" class="nav-link @(currentController == "User" && currentAction == "MyBorrowings" ? "active" : "")">
                                <i class="bi bi-journal-bookmark me-2"></i> My Borrowings
                            </a>
                        </li>
                    }
                </ul>
                <hr class="text-secondary">
                <div class="p-3">
                    <a href="/Auth/Logout" class="btn btn-outline-light w-100">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout (@User.Identity.Name)
                    </a>
                </div>
            </div>
        }

        <div class="flex-grow-1 main-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>