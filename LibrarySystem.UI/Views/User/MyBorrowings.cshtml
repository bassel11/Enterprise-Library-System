@model IEnumerable<LibrarySystem.Core.DTOs.UserBorrowingDto>
@{
    ViewData["Title"] = "My Borrowings";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-journal-bookmark text-primary me-2"></i> My Reading History</h2>
    </div>

    @await Html.PartialAsync("_NotificationsPartial")

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4 py-3">Book Title</th>
                            <th class="py-3">Author</th>
                            <th class="py-3">Borrow Date</th>
                            <th class="py-3">Status / Return Date</th>
                            <th class="text-end pe-4 py-3">Action</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">
                                    <i class="bi bi-book text-secondary opacity-50 me-2"></i> @item.BookTitle
                                </td>
                                <td>@item.Author</td>
                                <td>@item.BorrowDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (item.IsReturned)
                                    {
                                        <span class="text-success fw-bold">
                                            <i class="bi bi-check2-all me-1"></i> Returned on @item.ReturnDate?.ToString("MMM dd, yyyy")
                                        </span>
                                    }
                                    else if (item.IsOverdue)
                                    {
                                        <span class="badge bg-danger text-white px-3 py-2 rounded-pill shadow-sm">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> OVERDUE
                                        </span>
                                        <div class="text-muted small mt-1">
                                            Due was: @item.DueDate.ToString("MMM dd, yyyy")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">
                                            <i class="bi bi-clock me-1"></i> Active
                                        </span>
                                        <div class="text-muted small mt-1">
                                            Due: @item.DueDate.ToString("MMM dd, yyyy")
                                        </div>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (!item.IsReturned)
                                    {
                                        <form asp-action="ReturnBook" method="post" onsubmit="return confirm('Confirm returning this book?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="borrowId" value="@item.BorrowId" />
                                            <input type="hidden" name="bookId" value="@item.BookId" />

                                            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm transition">
                                                <i class="bi bi-arrow-return-left me-1"></i> Return Book
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-light rounded-pill px-3 text-muted border" disabled>
                                            <i class="bi bi-check"></i> Completed
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    You haven't borrowed any books yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>