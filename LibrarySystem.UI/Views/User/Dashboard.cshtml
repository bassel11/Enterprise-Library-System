@{
    ViewData["Title"] = "User Dashboard";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white overflow-hidden relative">
                <div class="card-body p-5">
                    <div class="position-relative z-1">
                        <h2 class="display-5 fw-bold mb-3">Welcome to your Library!</h2>
                        <p class="lead mb-4 opacity-75">Discover thousands of books, track your reading history, and manage your borrowings all in one place.</p>
                        <a href="/User/Search" class="btn btn-light text-primary rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-search me-2"></i> Start Exploring
                        </a>
                    </div>
                    <i class="bi bi-book position-absolute opacity-10" style="font-size: 15rem; right: -20px; top: -50px; transform: rotate(-15deg);"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <a href="/User/Search" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 hover-lift transition-all">
                    <div class="card-body p-4 text-center">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                            <i class="bi bi-search text-primary fs-2"></i>
                        </div>
                        <h4 class="fw-bold text-dark">Advanced Search</h4>
                        <p class="text-muted">Find exactly what you are looking for by Title, Author, or ISBN.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a href="/User/MyBorrowings" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 hover-lift transition-all">
                    <div class="card-body p-4 text-center">
                        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                            <i class="bi bi-journal-bookmark text-success fs-2"></i>
                        </div>
                        <h4 class="fw-bold text-dark">My Borrowings</h4>
                        <p class="text-muted">View your active borrowings and return books seamlessly.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
    }
</style>