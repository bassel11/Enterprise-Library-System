@model IEnumerable<LibrarySystem.Core.Entities.Book>
@{
    ViewData["Title"] = "Advanced Search";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8 text-center">
            <h2 class="fw-bold text-dark mb-3"><i class="bi bi-search text-primary me-2"></i> Find Your Next Book</h2>
            <p class="text-muted mb-4">Search our extensive catalog by Title, Author, or ISBN.</p>

            <form asp-action="Search" method="get" class="d-flex shadow-sm rounded-pill overflow-hidden">
                <input type="text" name="query" value="@ViewBag.SearchQuery" class="form-control border-0 px-4 py-3 bg-white" placeholder="Type title, author, or ISBN..." required>
                <button type="submit" class="btn btn-primary px-5 py-3 fw-bold">Search</button>
            </form>
        </div>
    </div>

    @await Html.PartialAsync("_NotificationsPartial")

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="ps-4 py-3">Book Title</th>
                                <th class="py-3">Author</th>
                                <th class="py-3">ISBN</th>
                                <th class="py-3">Status</th>
                                <th class="text-end pe-4 py-3">Action</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var book in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">
                                        <i class="bi bi-book text-secondary opacity-50 me-2"></i> @book.Title
                                    </td>
                                    <td>@book.Author</td>
                                    <td><span class="badge bg-secondary bg-opacity-10 text-secondary border">@book.ISBN</span></td>
                                    <td>
                                        @if (book.IsAvailable)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="bi bi-check-circle me-1"></i> Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger"><i class="bi bi-x-circle me-1"></i> Checked Out</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (book.IsAvailable)
                                        {
                                            <form asp-action="BorrowBook" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookId" value="@book.BookId" />
                                                <input type="hidden" name="searchQuery" value="@ViewBag.SearchQuery" />

                                                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 shadow-sm transition">
                                                    Borrow Now
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-light rounded-pill px-4 text-muted border" disabled>
                                                Unavailable
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
    {
        <div class="text-center py-5">
            <i class="bi bi-search text-muted display-1 opacity-25 mb-3 d-block"></i>
            <h4 class="text-muted">No books found matching "@ViewBag.SearchQuery"</h4>
            <p class="text-secondary">Try checking for typos or use different keywords.</p>
        </div>
    }
</div>

